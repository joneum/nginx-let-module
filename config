ngx_addon_name=ngx_http_let_module

HTTP_LET_SRCS="$ngx_addon_dir/src/ngx_http_let_module.c \
               $ngx_addon_dir/src/let.tab.c"
HTTP_LET_DEPS="$ngx_addon_dir/src/let.h \
               $ngx_addon_dir/src/let.tab.h"

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=$ngx_addon_name
    ngx_module_incs=
    ngx_module_deps="$HTTP_LET_DEPS"
    ngx_module_srcs="$HTTP_LET_SRCS"
    ngx_module_libs="-lcrypto"

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES $ngx_addon_name"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $HTTP_LET_SRCS"
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS $HTTP_LET_DEPS"
    CORE_LIBS="$CORE_LIBS -lcrypto"
fi
